<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" maxWidth="Infinity"
      style="-fx-background-color: rgba(6, 78, 59, 0.85); -fx-background-radius: 12;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.govipos.cashier.txmode.TxModeController">

    <padding>
        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
    </padding>

    <Label text="TRANSACTION MODE"
           style="-fx-text-fill: #a7f3d0; -fx-font-size: 11px; -fx-font-weight: bold;"/>

    <Button fx:id="cashSaleBtn"
            text="Cash Sale"
            maxWidth="Infinity"
            prefHeight="52.0"
            onAction="#onSelectCashSale"/>

    <Button fx:id="creditSaleBtn"
            text="Credit Sales"
            maxWidth="Infinity"
            prefHeight="52.0"
            onAction="#onSelectCreditSale"/>

</VBox>
