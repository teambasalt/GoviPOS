<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="rootShell"
            prefWidth="1366.0" prefHeight="768.0"
            styleClass="root-pane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.govipos.inventory.shell.InventoryShellController">

    <!-- Top Header Bar Slot -->
    <top>
        <StackPane fx:id="topBar" minHeight="80.0" prefHeight="80.0" maxHeight="80.0"/>
    </top>

    <!-- Main Scrollable Responsive Canvas Slot -->
    <center>
        <ScrollPane fx:id="centerScrollPane"
                    fitToWidth="true"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED">
            <content>
                <Pane fx:id="contentViewport">
                    <children>
                        <StackPane fx:id="dashboardPane"/>
                    </children>
                </Pane>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
